# ═══════════════════════════════════════════════════════════════════════════════
# NeuralVyuha — Example Environment Configuration
# Copy this file to .env and fill in the secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# --- Infrastructure ---
POSTGRES_USER=nv_user
POSTGRES_PASSWORD=nv_pass
POSTGRES_DB=nv_vault

REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092

# --- Security & Auth ---
JWT_SECRET=replaceme_with_a_long_random_string
ADMIN_PASSWORD=admin

# --- Artificial Intelligence ---
# Required for AI-assisted correlation and grouping
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Optional Integrations ---
CORTEX_URL=http://cortex:9001
CORTEX_API_KEY=
MISP_URL=http://misp:8080
MISP_API_KEY=

# --- Service Tuning ---
LOG_LEVEL=INFO
DRY_RUN=false
